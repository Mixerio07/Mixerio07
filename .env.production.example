# ── Настройки для самостоятельного хостинга ──────────────────
# Скопируйте этот файл как .env (или задайте переменные в панели хостинга)

# Секрет для подписи сессий — ОБЯЗАТЕЛЬНО замените на длинную случайную строку
APP_ID=kontek-portal
APP_SECRET=ЗАМЕНИТЕ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ_минимум_32_символа

# Подключение к вашей MySQL-базе
DATABASE_URL=mysql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:3306/ИМЯ_БАЗЫ

# Эти две переменные нужны только для входа через Kimi (на своём хостинге не используется,
# но переменные должны быть заданы — можно оставить как есть)
KIMI_AUTH_URL=https://auth.kimi.example
KIMI_OPEN_URL=https://open.kimi.example

# Пароль первичного администратора (логин: admin).
# Действует только при ПЕРВОМ запуске на пустой базе. После входа смените его в портале.
ADMIN_PASSWORD=admin12345

# Порт (если хостинг требует другой)
PORT=3000
